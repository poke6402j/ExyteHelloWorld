    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "lowerLimit = IN[0] #double\r\nupperLimit = IN[1] #double\r\nequBottomPointZ = IN[2] #double\r\nequTopPointZ = IN[3] #double\r\nelements = IN[4] #List<Element>\r\n\r\nOUT = [[], [], []] #定義Python Node 輸出格式\r\n\r\n#針對每個element做for迴圈運算\r\nfor i in range(len(elements)): \r\n    \r\n    clearHeight = equTopPointZ[i] - equBottomPointZ[i]\r\n    \r\n    #clearHeight 比 lowerLimit 更低\r\n    if clearHeight < lowerLimit:\r\n        OUT[0].append(elements[i])\r\n                \r\n    #clearHeight 介於 lowerLimit 與 upperLimit\r\n    elif (clearHeight > lowerLimit) and (clearHeight < upperLimit):\r\n        OUT[1].append(elements[i])\r\n        \r\n    #clearHeight 比 upperLimit 更高\r\n    elif clearHeight > upperLimit:\r\n        OUT[2].append(elements[i])",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "95a3385971a743a1b69795f5e0a4a9ba",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "24a13d96cc83448aaa65025d27254375",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
