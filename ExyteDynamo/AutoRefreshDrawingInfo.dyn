    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport sys\r\nsys.path.append('C:\\Program Files (x86)\\IronPython 2.7\\Lib')\r\nimport System\r\nfrom System import Array\r\nfrom System.Collections.Generic import *\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager \r\nfrom RevitServices.Transactions import TransactionManager \r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitAPIUI\")\r\n\r\nimport Autodesk \r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication \r\napp = uiapp.Application \r\nuidoc = uiapp.ActiveUIDocument\r\n\r\nVSs = UnwrapElement(IN[0][1])\r\nVPs = UnwrapElement(IN[1])\r\nTBs = UnwrapElement(IN[2])\r\n\r\nitems = UnwrapElement(IN[3][0])\r\n\r\nVScales, VSizes = [], []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nOUT = []\r\nfor i in range(len(VSs)):\r\n    out = [VSs[i].SheetNumber]\r\n    #Scale\r\n    if \"Drawing Scale\" in items:\r\n        \r\n        try:\r\n            scale = VSs[i].LookupParameter(\"ex_T_06-SCALE\").AsString()\r\n        except:\r\n            scale = \"\"\r\n            \r\n        VP = VPs[i]\r\n        \r\n        VScale = []\r\n        for vp in VP:\r\n            vt = vp.ViewType\r\n            if vt == ViewType.CeilingPlan or vt == ViewType.FloorPlan or vt == ViewType.Elevation or vt == ViewType.Section or vt == ViewType.Detail or vt == ViewType.ThreeD:\r\n                VScale.append(vp.Scale)\r\n                \r\n        if len(VScale) == 1:\r\n            VScale = \"1:\" + str(VScale[0])\r\n        elif (len(VScale) > 1 and len(list(set(VScale))) == 1):\r\n            VScale = \"1:\" + str(VScale[0])\r\n        else:\r\n            VScale = \"NONE\"\r\n            \r\n        try:\r\n            out.append(VScale)    \r\n            VSs[i].LookupParameter(\"ex_T_06-SCALE\").Set(VScale)\r\n        except:\r\n            None\r\n    \r\n    #Size    \r\n    if \"Drawing Size\" in items:   \r\n        try: \r\n            size = VSs[i].LookupParameter(\"ex_T_00-SIZE\").AsString()\r\n        except:\r\n            size = \"\"\r\n        \r\n        if TBs[i].Name[-2:] in [\"A0\", \"A1\", \"A2\", \"A3\", \"A4\"]:\r\n            VSize = TBs[i].Name[-2:]\r\n        else:\r\n            VSize = \"\"\r\n            \r\n        try:\r\n            out.append(VSize)   \r\n            VSs[i].LookupParameter(\"ex_T_00-SIZE\").Set(VSize)\r\n        except:\r\n            None\r\n                \r\n    #LatestInfo  \r\n    if \"Latest Info\" in items:\r\n        rev, date, index, draw, chk = \"\", \"\", \"\", \"\", \"\"\r\n        \r\n        try:\r\n            date = VSs[i].LookupParameter(\"ex_T_LatestDATE\").AsString()\r\n        except:\r\n            date = \"\"\r\n        try:\r\n            index = VSs[i].LookupParameter(\"ex_T_LatestINDEX\").AsString()\r\n        except:\r\n            date = \"\"\r\n        try:\r\n            draw = VSs[i].LookupParameter(\"ex_T_LatestDRAW\").AsString()\r\n        except:\r\n            draw = \"\"\r\n        try:\r\n            chk = VSs[i].LookupParameter(\"ex_T_LatestCHK\").AsString()\r\n        except:\r\n            chk = \"\"\r\n        \r\n        for j in range(1,9):\r\n            \r\n            if VSs[i].LookupParameter(\"ex_T_1{}A-REV_{}\".format(str(j), str(j))).HasValue:\r\n                \r\n                _rev = VSs[i].LookupParameter(\"ex_T_1{}A-REV_{}\".format(str(j), str(j))).AsString()\r\n                \r\n                if len(_rev.strip()) > 0:\r\n                    try:\r\n                        rev = VSs[i].LookupParameter(\"ex_T_1{}A-REV_{}\".format(str(j), str(j))).AsString()\r\n                    except:\r\n                        rev = \"\"\r\n                    try:\r\n                        date = VSs[i].LookupParameter(\"ex_T_1{}B-DATE_{}\".format(str(j), str(j))).AsString()\r\n                    except:\r\n                        date = \"\"\r\n                    try:\r\n                        index = VSs[i].LookupParameter(\"ex_T_1{}C-INDEX_{}\".format(str(j), str(j))).AsString()\r\n                    except:\r\n                        index = \"\"\r\n                    try:\r\n                        draw = VSs[i].LookupParameter(\"ex_T_1{}D-DRAW_{}\".format(str(j), str(j))).AsString()\r\n                    except:\r\n                        draw = \"\"\r\n                    try:\r\n                        chk = VSs[i].LookupParameter(\"ex_T_1{}E-CHK_{}\".format(str(j), str(j))).AsString()\r\n                    except:\r\n                        chk = \"\"\r\n        try:                        \r\n            out.append([rev, date, index, draw, chk])  \r\n            VSs[i].LookupParameter(\"ex_T_LatestDATE\").Set(date)\r\n            VSs[i].LookupParameter(\"ex_T_LatestINDEX\").Set(index)\r\n            VSs[i].LookupParameter(\"ex_T_LatestDRAW\").Set(draw)\r\n            VSs[i].LookupParameter(\"ex_T_LatestCHK\").Set(chk)\r\n        except:\r\n            None\r\n       #KeyPlan  \r\n    if \"Key Plan\" in items:\r\n        if len(VSs[i].SheetNumber) == 8:\r\n            try: \r\n                BLDG = VSs[i].SheetNumber[2]\r\n            except:\r\n                BLDG = \"\"\r\n            keyPlan = [p for p in TBs[i].Parameters if p.Definition.ParameterGroup == BuiltInParameterGroup.PG_VISIBILITY]\r\n            \r\n            for k in keyPlan:\r\n                try:\r\n                    if k.Definition.Name == BLDG:\r\n                        k.Set(1)\r\n                        out.append(BLDG)  \r\n                    else:\r\n                        k.Set(0)                    \r\n                except:\r\n                    None  \r\n    OUT.append(out)\r\n        \r\nTransactionManager.Instance.TransactionTaskDone()",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "299acb5025e749f489c4a4bafae9bf06",
